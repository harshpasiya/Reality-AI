# Copy to frontend/.env.local (gitignored) and fill in.

# Backend URL (the FastAPI server).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps JavaScript API key (Maps JavaScript API enabled). Without it the
# chat still works and the map shows a "not configured" note.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: your own map style ID. Leave empty to use Google's demo map ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: Gemini key for the broker "describe the property" autofill.
# Server-side only (never exposed to the browser).
GEMINI_API_KEY=
