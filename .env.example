# Reality AI — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# Variable names are frozen per AGENTS.md — do not rename them.

# ──────────────────────────────────────────────────────────────────────
# DATABASE_URL — PostgreSQL connection string (shared by Backend + AI track).
# Used by: ai/embeddings/embed_listings.py, ai/amenities/amenities_service.py
# Format:  postgresql://user:password@host:port/database_name
# ──────────────────────────────────────────────────────────────────────
# The local docker-compose database uses user reality_ai and the password set
# in POSTGRES_PASSWORD (see docker-compose.yml for the dev default).
DATABASE_URL=postgresql://reality_ai:CHANGE_ME@localhost:5433/reality_ai

# ──────────────────────────────────────────────────────────────────────
# GOOGLE_PLACES_API_KEY — Google Places Nearby Search API key.
# Used by: ai/amenities/amenities_service.py
# Called ONCE at listing-creation time to cache nearby POIs.
# NEVER called live during a chat or search request.
# Get it from: https://console.cloud.google.com/  (enable Places API)
# ──────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────────────────────────────
# HF_TOKEN — HuggingFace access token (fine-grained, read+write).
# Optional: the Qwen3 models are not gated, so downloads work without it.
# Useful only for higher download rate limits or pushing the trained LoRA
# adapter to a private HF repo.
# Get it from: https://huggingface.co/settings/tokens
# ──────────────────────────────────────────────────────────────────────
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────────────────────────────
# NLU_BACKEND — how customer messages are turned into search filters.
#   hybrid (default): rules + the Qwen3 LoRA model, merged; falls back to
#                     rules automatically when there's no GPU or adapter
#   rules:            rules only (fast, no GPU) — fine for backend/frontend dev
#   model:            model output only, no merge (for evaluation)
# The model IDs are constants in ai/inference/load_model.py; see
# ai/docs/ADR-002-qwen3-nlu-model.md.
# ──────────────────────────────────────────────────────────────────────
NLU_BACKEND=hybrid

# ──────────────────────────────────────────────────────────────────────
# NLU_ALLOW_CPU_MODEL — set to 1 to load the 4B NLU model on CPU when no
# GPU is present. Off by default: it needs ~8 GB+ RAM and takes seconds per
# message, so rules-only is the better choice on CPU machines.
# ──────────────────────────────────────────────────────────────────────
# NLU_ALLOW_CPU_MODEL=1
