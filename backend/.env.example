# Reality AI Backend Environment Variables
# Exact names per AGENTS.md cross-team specification — DO NOT RENAME

# ── For local development (app running outside Docker) ─────────────────────
# DATABASE_URL points to localhost when the app is run directly with uvicorn.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reality_ai

# ── For Docker Compose (api service) ──────────────────────────────────────
# docker-compose.yml builds its own DATABASE_URL with the hostname 'db'
# (the service name), so this line is only needed when overriding it.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/reality_ai

# Secret key used for JWT authentication signing — REQUIRED, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL container configuration (used by docker-compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reality_ai

# pgAdmin login (docker-compose db_admin service) — required by docker-compose
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=

# AI placeholder mode — set to false once Person 1's ai/ package is available
PLACEHOLDER_MODE=true

# Comma-separated frontend origins allowed by CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Google Places key — read by Person 1's amenities service, never by the backend
GOOGLE_PLACES_API_KEY=

# Directory for uploaded listing photos (served at /uploads)
UPLOAD_DIR=uploads
